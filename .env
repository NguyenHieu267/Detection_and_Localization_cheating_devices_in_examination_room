# Edit this file, then restart services. Three .bat files use these values.

# --- 1. MODE AND SESSION ---
COLLECTION_MODE=true
SESSION_ID=morning

# --- 2. HOTSPOT / MQTT ---
MQTT_HOST=10.202.23.160
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=rf-gateway-mvp
MOSQUITTO_EXE=C:/Program Files/mosquitto/mosquitto.exe

# --- 3. TARGET PHONE ---
TARGET_DEVICE_MAC=3E:0E:02:0C:13:02
TARGET_DEVICE_TOKEN=
DEVICE_TOKEN_SALT=secret-key
LOCALIZE_TARGET_ONLY=true

# --- 4. ROOM / GRID (metres) ---
ROOM_WIDTH_M=9
ROOM_LENGTH_M=9
GRID_CELL_WIDTH_M=0.6
GRID_CELL_LENGTH_M=0.6

# --- 5. COLLECTION (seconds / milliseconds) ---
COLLECTION_CSV_PATH=database/401c4.csv
COLLECTION_DURATION_S=30
COLLECTION_RECEIVE_WAIT_MS=3000

# --- 6. REALTIME / COORDINATE FILTER ---
REALTIME_CSV_PATH=database/localization.csv
POSITION_FILTER_MODE=ema
POSITION_EMA_ALPHA=0.35
POSITION_EMA_RESET_GAP=3

# --- 7. AI MODEL / TRAINING ---
AI_MODEL_PATH=model/output/model.joblib
AI_DATASET_PATH=model/dataset-vectors.csv
AI_WINDOW_SIZE=10

# --- 8. WEB SERVER ---
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_URL=http://127.0.0.1:8000

# --- 9. NODE / EPOCH TIMING (milliseconds) ---
EPOCH_TIMEOUT_MS=1800
MIN_OVERLAP_MS=600
NODE_OFFLINE_TIMEOUT_MS=3500
MAX_WS_CLIENTS=64
