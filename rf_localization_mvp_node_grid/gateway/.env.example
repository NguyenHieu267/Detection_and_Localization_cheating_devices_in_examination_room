# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=rf-gateway-mvp

# Database
DATABASE_PATH=rf_gateway.db

# Room and fixed grid size
ROOM_WIDTH_M=8.0
ROOM_LENGTH_M=12.0
GRID_CELL_WIDTH_M=2.0
GRID_CELL_LENGTH_M=4.0

# Node online/offline detection. A node is online while MQTT traffic
# has been received within this many milliseconds.
NODE_OFFLINE_TIMEOUT_MS=3500

# First-test focus. Leave TARGET_DEVICE_TOKEN empty when using MAC.
TARGET_DEVICE_MAC=
TARGET_DEVICE_TOKEN=
DEVICE_TOKEN_SALT=rf-mvp-shared-salt-change-me
LOCALIZE_TARGET_ONLY=true

EPOCH_TIMEOUT_MS=1800
MAX_WS_CLIENTS=64
